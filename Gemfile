source "https://rubygems.org"

# Matches the Jekyll version and plugins GitHub Pages uses in production.
# Includes jekyll-feed, jekyll-seo-tag, jekyll-sitemap and jekyll-paginate.
gem "github-pages", group: :jekyll_plugins

# Windows and JRuby do not include zoneinfo files
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

gem "webrick", "~> 1.8"
